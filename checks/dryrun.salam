package main

import parse "../src/telegram/parse.salam"
import str
import time
import telegram.bot
import config "../src/config.salam"
import store "../src/storage/store.salam"
import settings "../src/storage/settings.salam"
import engine "../src/engine/engine.salam"
import tgbot "../src/telegram/tgbot.salam"

func Message(chat_id: i64, id: i64, text: str): bot.Update:
    ret bot.Update {
        update_id = id,
        has_message = true,
        message = bot.Message { message_id = id, text = text, chat = bot.Chat { id = chat_id, chat_type = "private" } }
    }
end

func Tap(chat_id: i64, id: i64, panel_id: i64, data: str, panel_text: str): bot.Update:
    ret bot.Update {
        update_id = id,
        has_callback_query = true,
        callback_query = bot.CallbackQuery {
            id = str.FromInt(id),
            data = data,
            has_message = true,
            message = bot.Message { message_id = panel_id, text = panel_text, chat = bot.Chat { id = chat_id, chat_type = "private" } }
        }
    }
end

func main:
    c := config.Load()
    if !config.Ok(c):
        println "TELEGRAM_BOT_TOKEN is missing"
        ret
    end

    if !store.Open("/tmp/salam-dryrun.sqlite"):
        println "could not open the scratch database"
        ret
    end
    settings.Init(c)
    if !tgbot.Init(c):
        ret
    end
    engine.Start(c)

    ids := str.Split(c.admin_ids, ",")
    chat_id := parse.ParseInt64(ids.get(0))
    println "driving a conversation in chat " + str.FromInt(chat_id)

    println "→ /start"
    tgbot.Dispatch(Message(chat_id, 1 as i64, "/start"))

    println "→ /settings"
    tgbot.Dispatch(Message(chat_id, 2 as i64, "/settings"))

    println "→ /order with a bad direction"
    tgbot.Dispatch(Message(chat_id, 3 as i64, "/order EURUSD sideways 1.08"))

    println "→ /new (the panel)"
    tgbot.Dispatch(Message(chat_id, 4 as i64, "/new"))

    println "→ tapping the chart button"
    tgbot.Dispatch(Tap(chat_id, 5 as i64, 0 as i64, "w:chart", ""))
    time.Sleep(500)

    println "→ choosing heikin-ashi"
    tgbot.Dispatch(Tap(chat_id, 6 as i64, 0 as i64, "w:chart:heikin_ashi", ""))
    time.Sleep(500)

    println "→ tapping ✍️ price, then typing one"
    tgbot.Dispatch(Tap(chat_id, 7 as i64, 0 as i64, "w:price", ""))
    time.Sleep(500)
    tgbot.Dispatch(Message(chat_id, 8 as i64, "۱٫۱۶۳۵۸"))
    time.Sleep(500)

    println "→ the timeframe menu, then 5m"
    tgbot.Dispatch(Tap(chat_id, 9 as i64, 0 as i64, "w:tf", ""))
    time.Sleep(400)
    tgbot.Dispatch(Tap(chat_id, 10 as i64, 0 as i64, "w:tf:300", ""))
    time.Sleep(400)

    println "→ opening and closing the in-panel help"
    tgbot.Dispatch(Tap(chat_id, 11 as i64, 0 as i64, "w:info", ""))
    time.Sleep(400)
    tgbot.Dispatch(Tap(chat_id, 12 as i64, 0 as i64, "w:info", ""))
    time.Sleep(400)

    println "→ flipping direction, account, entry and expiry"
    tgbot.Dispatch(Tap(chat_id, 13 as i64, 0 as i64, "w:direction", ""))
    tgbot.Dispatch(Tap(chat_id, 14 as i64, 0 as i64, "w:trigger", ""))
    tgbot.Dispatch(Tap(chat_id, 15 as i64, 0 as i64, "w:expiry", ""))
    time.Sleep(400)
    println "→ back to a fixed expiry, and a typed duration"
    tgbot.Dispatch(Tap(chat_id, 16 as i64, 0 as i64, "w:expiry", ""))
    tgbot.Dispatch(Tap(chat_id, 17 as i64, 0 as i64, "w:duration", ""))
    time.Sleep(400)
    tgbot.Dispatch(Message(chat_id, 18 as i64, "۲ دقیقه"))
    time.Sleep(400)

    println "→ a typed amount, and a rejected one first"
    tgbot.Dispatch(Tap(chat_id, 19 as i64, 0 as i64, "w:amount", ""))
    time.Sleep(400)
    tgbot.Dispatch(Message(chat_id, 20 as i64, "nonsense"))
    time.Sleep(400)
    tgbot.Dispatch(Message(chat_id, 21 as i64, "2"))
    time.Sleep(400)

    println "→ a typed symbol, then submitting the panel"
    tgbot.Dispatch(Tap(chat_id, 22 as i64, 0 as i64, "w:symbol", ""))
    time.Sleep(400)
    tgbot.Dispatch(Message(chat_id, 23 as i64, "eurusd otc"))
    time.Sleep(400)
    tgbot.Dispatch(Tap(chat_id, 24 as i64, 0 as i64, "w:submit", ""))
    time.Sleep(1000)

    mut from_panel := store.ListActiveByChat(chat_id)
    println "orders after the panel submit: " + str.FromInt(from_panel.len() as i64)
    if from_panel.len() > 0:
        p := from_panel.get(0)
        println "  " + p.id + " " + p.symbol + " " + p.direction + " " + p.expiry_mode +
            " dur=" + str.FromInt(p.duration_seconds) + " tf=" + str.FromInt(p.timeframe_seconds) +
            " amount=" + str.FromFloat(p.amount) + " entry=" + p.trigger_mode + " chart=" + p.chart_type
        println "→ cancelling it"
        tgbot.Dispatch(Message(chat_id, 25 as i64, "/cancel " + p.id))
    end
    from_panel.free()

    println "→ /order (a real pending order, far from the market)"
    tgbot.Dispatch(Message(chat_id, 30 as i64, "/order EURUSD_otc buy 9.99999 dur=60 amount=1 acc=demo valid=2m"))

    println "→ /list"
    tgbot.Dispatch(Message(chat_id, 31 as i64, "/list"))

    println "→ /stats"
    tgbot.Dispatch(Message(chat_id, 32 as i64, "/stats"))

    println "→ letting the engine run for a few seconds"
    mut i := 0
    while i < 30:
        engine.Step(100)
        tgbot.Notify()
        i = i + 1
    end

    mut active := store.ListActiveByChat(chat_id)
    println "active orders in the scratch database: " + str.FromInt(active.len() as i64)
    if active.len() > 0:
        o := active.get(0)
        println "  " + o.id + " " + o.symbol + " " + o.status + " side=" + o.approach_side + " ref=" + str.FromFloat(o.reference_price)
        println "→ cancelling it"
        tgbot.Dispatch(Message(chat_id, 33 as i64, "/cancel " + o.id))
    end
    active.free()

    println "→ /status"
    tgbot.Dispatch(Message(chat_id, 34 as i64, "/status"))

    engine.Stop()
    store.Close()
    println "done"
end
