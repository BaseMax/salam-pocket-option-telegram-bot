// The stdlib's assertions take no message; these keep one, because a
// failing line should say what property it was checking.
func EqInt(got: i64, want: i64, message: str):
    testing.AssertMsg(got == want, message)
end

func EqStr(got: str, want: str, message: str):
    testing.AssertMsg(got == want, message)
end

func EqFloat(got: f64, want: f64, message: str):
    testing.AssertMsg(got > want - 0.000001 && got < want + 0.000001, message)
end

func Truthy(condition: bool, message: str):
    testing.AssertMsg(condition, message)
end

func Falsy(condition: bool, message: str):
    testing.AssertMsg(!condition, message)
end

func Has(haystack: str, needle: str, message: str):
    testing.AssertMsg(str.Contains(haystack, needle), message)
end

func TestDurations():
    EqInt(timex.ParseDuration("60"), 60, "a bare number is seconds")
    EqInt(timex.ParseDuration("31s"), 31, "seconds suffix")
    EqInt(timex.ParseDuration("1m"), 60, "minutes")
    EqInt(timex.ParseDuration("1M"), 60, "case does not matter")
    EqInt(timex.ParseDuration("30 M"), 1800, "a space does not matter")
    EqInt(timex.ParseDuration("2h"), 7200, "hours")
    EqInt(timex.ParseDuration("1.5m"), 90, "a fraction of a unit")
    EqInt(timex.ParseDuration("5 MINUTES"), 300, "long unit names")
    EqInt(timex.ParseDuration("2hours"), 7200, "no space, long name")
    EqInt(timex.ParseDuration("3 days"), 259200, "days")
    EqInt(timex.ParseDuration("1 week"), 604800, "weeks")
    EqInt(timex.ParseDuration("1 month"), 2592000, "months")
    EqInt(timex.ParseDuration("1h 30m"), 5400, "two parts")
    EqInt(timex.ParseDuration("1H30M"), 5400, "two parts, no space")

    EqInt(timex.ParseDuration("۳۰ دقیقه"), 1800, "Persian digits and unit")
    EqInt(timex.ParseDuration("90 ثانیه"), 90, "Persian seconds")
    EqInt(timex.ParseDuration("۲ ساعت و ۱۵ دقیقه"), 8100, "Persian, joined with و")
    EqInt(timex.ParseDuration("1 روز"), 86400, "Persian days")
    EqInt(timex.ParseDuration("۱٫۵ دقیقه"), 90, "Persian decimal separator")

    EqInt(timex.ParseDuration(""), 0 - 1, "empty is invalid")
    EqInt(timex.ParseDuration("abc"), 0 - 1, "words are invalid")
    EqInt(timex.ParseDuration("5 bananas"), 0 - 1, "an unknown unit is invalid")
    EqInt(timex.ParseDuration("0"), 0 - 1, "zero is not a duration")
    EqInt(timex.ParseDuration("1:30"), 0 - 1, "a clock time is not a duration")
end

func TestFormatting():
    EqStr(timex.FormatDuration(5 as i64), "5s", "seconds")
    EqStr(timex.FormatDuration(90 as i64), "1m30s", "minutes and seconds")
    EqStr(timex.FormatDuration(5400 as i64), "1h30m", "hours and minutes")
    EqStr(timex.FormatDuration(86400 as i64), "1d", "days")
    EqStr(timex.FormatDurationFa(5400 as i64), "1 ساعت و 30 دقیقه", "Persian duration")
    EqStr(timex.FormatDurationFa(90061 as i64), "1 روز و 1 ساعت و 1 دقیقه و 1 ثانیه", "every Persian unit")

    // Every compact form reads back as the same number of seconds.
    EqInt(timex.ParseDuration(timex.FormatDuration(5400 as i64)), 5400, "round trip 5400")
    EqInt(timex.ParseDuration(timex.FormatDuration(90061 as i64)), 90061, "round trip 90061")

    EqStr(timex.FormatTime(0.0, 0 as i64), "1970-01-01 00:00:00", "the epoch in UTC")
    EqStr(timex.FormatTime(0.0, 210 as i64), "1970-01-01 03:30:00", "the epoch in Tehran")
    EqStr(timex.FormatPrice(1.95320), "1.9532", "trailing zeros are trimmed")
    EqStr(timex.FormatMoney(0.0 - 5.0), "-$5.00", "a loss keeps its sign")
end

func TestSymbols():
    EqStr(symbols.Normalize("gbpaud_otc"), "GBPAUD_otc", "otc suffix")
    EqStr(symbols.Normalize("GBPAUD-OTC"), "GBPAUD_otc", "a dash is a separator")
    EqStr(symbols.Normalize("eur/usd"), "EURUSD", "a slash is a separator")
    EqStr(symbols.Normalize("  eurusd  "), "EURUSD", "spaces are trimmed")
    EqStr(symbols.Twin("EURUSD"), "EURUSD_otc", "the weekend listing")
    EqStr(symbols.Twin("EURUSD_otc"), "EURUSD", "and back")
    Truthy(symbols.IsOtc("EURUSD_otc"), "otc detected")
    Falsy(symbols.IsOtc("EURUSD"), "not otc")

    mut assets := Vector {} as Vector<symbols.Asset>
    defer assets.free()
    assets.push(symbols.Asset { symbol = "EURUSD", name = "Euro/Dollar", payout = 70 as i64, is_open = true })
    assets.push(symbols.Asset { symbol = "EURUSD_otc", name = "Euro/Dollar OTC", payout = 90 as i64, is_open = true })
    assets.push(symbols.Asset { symbol = "GBPJPY", name = "Pound/Yen", payout = 95 as i64, is_open = false })

    mut status := ""
    mut matched := symbols.Asset {}
    mut twin := symbols.Asset {}
    _n := symbols.Resolve("eurusd", assets, status, matched, twin)
    EqStr(status, "exact", "an exact match")
    EqStr(twin.symbol, "EURUSD_otc", "its twin comes along")

    _u := symbols.Resolve("zzzz", assets, status, matched, twin)
    EqStr(status, "unknown", "an unknown symbol")

    mut ranked := symbols.Suggest("EUR", assets)
    defer ranked.free()
    EqInt(ranked.len(), 2, "two suggestions")
    EqStr(ranked.get(0).symbol, "EURUSD_otc", "the better payout leads")

    // The listing is the same search without the hint-sized cap, and it is
    // what /symbols pages through.
    mut found := symbols.Search("USD", assets)
    defer found.free()
    EqInt(found.len(), 2, "the search keeps every match")
    EqStr(found.get(0).symbol, "EURUSD_otc", "sorted by payout, best first")
    EqStr(found.get(1).symbol, "EURUSD", "then the thinner one")

    mut open := symbols.Tradable(assets)
    defer open.free()
    EqInt(open.len(), 2, "a closed market is not tradable")
    EqStr(open.get(0).symbol, "EURUSD_otc", "the fattest payout leads the listing")
    EqStr(open.get(1).symbol, "EURUSD", "and the rest follow it down")
end

/*
 * The payout floor.
 *
 * The percentage beside a symbol moves all day, so the only reading that
 * decides anything is the one taken in the second the trade would be sent.
 * These are the rules that reading is put through.
 */
func TestPayoutFloor():
    Truthy(engine.PayoutAllows(0 as i64, 35 as i64, true), "an order with no floor takes any payout")
    Truthy(engine.PayoutAllows(90 as i64, 92 as i64, true), "a fatter payout passes")
    Truthy(engine.PayoutAllows(90 as i64, 90 as i64, true), "and so does the floor exactly")
    Falsy(engine.PayoutAllows(90 as i64, 89 as i64, true), "one percent short does not")
    Falsy(engine.PayoutAllows(90 as i64, 0 as i64, false), "an unquoted payout cannot clear a floor")
    Truthy(engine.PayoutAllows(0 as i64, 0 as i64, false), "but it does not matter without one")

    EqInt(parse.Percent("90"), 90, "a bare percentage")
    EqInt(parse.Percent("۸۵"), 85, "Persian digits")
    EqInt(parse.Percent("92%"), 92, "a percent sign is forgiven")
    EqInt(parse.Percent("۷۷٪"), 77, "and so is the Persian one")
    EqInt(parse.Percent("0"), 0, "zero is a real answer: no condition")
    EqInt(parse.Percent("101"), 0 - 1, "over a hundred is refused")
    EqInt(parse.Percent("-5"), 0 - 1, "so is a negative one")
    EqInt(parse.Percent("ninety"), 0 - 1, "and so is a word")

    mut o := types.Order {}
    o.id = "A7K2"
    o.symbol = "EURUSD_otc"
    o.min_payout = 90 as i64
    Has(texts.RenderOrder(o, 210 as i64, false), "90٪ و بالاتر", "the card shows the floor")
    Has(texts.StatusLabel(types.ST_SKIPPED), "انجام نشد", "and a skipped order says so")

    mut none := types.Order {}
    none.id = "B3M4"
    Falsy(str.Contains(texts.RenderOrder(none, 210 as i64, false), "حداقل نرخ پرداخت"),
        "an order without a floor does not mention one")
end

func TestOrderCommand():
    mut spec := types.OrderSpec {}
    problem := parse.ParseOrder("gbpaud_otc buy 1.9532", spec)
    EqStr(problem, "", "a minimal command parses")
    EqStr(spec.symbol, "GBPAUD_otc", "symbol")
    EqStr(spec.direction, types.CALL, "direction")

    mut full := types.OrderSpec {}
    p2 := parse.ParseOrder("EURUSD sell 1.0854 tf=5m dur=90 amount=7 acc=real entry=next chart=ha valid=30m", full)
    EqStr(p2, "", "the full tail parses")
    EqInt(full.timeframe_seconds, 300, "tf")
    EqInt(full.duration_seconds, 90, "dur")
    EqStr(full.account_mode, types.MODE_REAL, "acc")
    EqStr(full.chart_type, types.CHART_HEIKIN_ASHI, "chart")
    EqStr(full.trigger_mode, types.TRIGGER_NEXT_CANDLE, "entry")
    EqInt(full.valid_for_seconds, 1800, "valid")

    mut persian := types.OrderSpec {}
    p3 := parse.ParseOrder("EURUSD فروش ۱٫۰۸۵۴ dur=۲دقیقه acc=واقعی chart=هایکن exp=شناور", persian)
    EqStr(p3, "", "Persian words parse")
    EqStr(persian.direction, types.PUT, "Persian direction")
    EqInt(persian.duration_seconds, 120, "Persian duration")
    EqStr(persian.expiry_mode, types.EXPIRY_FLOATING, "Persian expiry")

    mut floor := types.OrderSpec {}
    p4 := parse.ParseOrder("EURUSD buy 1.0854 payout=90", floor)
    EqStr(p4, "", "a payout floor parses")
    EqInt(floor.min_payout, 90, "and reaches the spec")

    mut bad := types.OrderSpec {}
    Truthy(parse.ParseOrder("EURUSD buy 1.08 payout=140", bad).len() > 0, "a payout over 100 is refused")
    Truthy(parse.ParseOrder("EURUSD sideways 1.08", bad).len() > 0, "a bad direction is refused")
    Truthy(parse.ParseOrder("EURUSD buy 1.08 nope=1", bad).len() > 0, "an unknown key is refused")
    Truthy(parse.ParseOrder("EURUSD buy zero", bad).len() > 0, "a bad price is refused")
end

func TestTrigger():
    EqStr(engine.ResolveApproachSide(1.10, 1.05, true), types.SIDE_BELOW, "the market sits below")
    EqStr(engine.ResolveApproachSide(1.00, 1.05, true), types.SIDE_ABOVE, "the market sits above")
    EqStr(engine.ResolveApproachSide(1.05, 0.0, false), types.SIDE_ANY, "no reference yet")

    below := types.Order { trigger_price = 1.10, approach_side = types.SIDE_BELOW }
    Falsy(engine.IsTouched(below, 1.05, true, 1.09), "not yet risen into it")
    Truthy(engine.IsTouched(below, 1.09, true, 1.10), "exactly on it")
    Truthy(engine.IsTouched(below, 1.09, true, 1.15), "gapped straight over it")

    above := types.Order { trigger_price = 1.00, approach_side = types.SIDE_ABOVE }
    Falsy(engine.IsTouched(above, 1.05, true, 1.01), "not yet fallen into it")
    Truthy(engine.IsTouched(above, 1.01, true, 0.99), "fell through it")

    any := types.Order { trigger_price = 1.05, approach_side = types.SIDE_ANY }
    Truthy(engine.IsTouched(any, 1.04, true, 1.06), "crossed from below")
    Truthy(engine.IsTouched(any, 1.06, true, 1.04), "crossed from above")
    Falsy(engine.IsTouched(any, 1.06, true, 1.07), "never crossed")
end

func TestExpiry():
    fixed := types.Order { expiry_mode = types.EXPIRY_FIXED, duration_seconds = 90 as i64 }
    mut close_at := 0.0
    mut rolled := 0 as i64
    duration := engine.ResolveExpiry(fixed, 1000.0, 30 as i64, close_at, rolled)
    EqInt(duration, 90, "a fixed trade is sent as seconds")
    EqFloat(close_at, 0.0, "and never as an absolute close")

    floating := types.Order { expiry_mode = types.EXPIRY_FLOATING, timeframe_seconds = 60 as i64, candle_count = 1 as i64 }
    entry := 1787911237.0
    _d2 := engine.ResolveExpiry(floating, entry, 5 as i64, close_at, rolled)
    EqFloat(close_at, timex.CandleCloseTime(entry, 60 as i64), "it lands on the candle close")
    EqInt(rolled, 0, "with nothing to roll")

    three := types.Order { expiry_mode = types.EXPIRY_FLOATING, timeframe_seconds = 60 as i64, candle_count = 3 as i64 }
    _d3 := engine.ResolveExpiry(three, entry, 5 as i64, close_at, rolled)
    EqFloat(close_at, timex.CandleCloseTime(entry, 60 as i64) + 120.0, "three candles out")

    // Five seconds before the minute closes, with a 30 second floor.
    late := 1787911255.0
    _d4 := engine.ResolveExpiry(floating, late, 30 as i64, close_at, rolled)
    EqInt(rolled, 1, "it rolls one candle forward")
    Truthy(close_at - late >= 30.0, "and clears the broker minimum")
end

func TestJson():
    mut rows := jsonx.SplitArray(`[["EURUSD",1787911237.5,1.08541],["GBPAUD_otc",1787911238,1.9532]]`)
    EqInt(rows.len(), 2, "two ticks")
    mut cols := jsonx.SplitArray(rows.get(0))
    EqStr(jsonx.Unquote(cols.get(0)), "EURUSD", "the symbol")
    EqFloat(jsonx.AsFloat(cols.get(2)), 1.08541, "the price")
    cols.free()
    rows.free()

    obj := `{"id":"deal-9","profit":1.8,"closeTime":1787911300,"amount":null}`
    EqStr(jsonx.Unquote(jsonx.Field(obj, "id")), "deal-9", "a string field")
    EqFloat(jsonx.FieldFloat(obj, "profit"), 1.8, "a number field")
    Truthy(jsonx.IsNull(jsonx.Field(obj, "amount")), "null is not zero")
    EqStr(jsonx.FieldAny(obj, "closeTimestamp", "closeTime"), "1787911300", "either spelling")
    EqStr(jsonx.ElementAt(`[{"a":[1,2]},"x"]`, 1), `"x"`, "nested commas are skipped")
end

func TestSsid():
    legacy := ssid.Parse(`42["auth",{"session":"abc","isDemo":1,"uid":5,"platform":1}]`, types.MODE_DEMO, 0 as i64)
    Truthy(legacy.ok, "the older dialect is read")
    EqInt(legacy.uid, 5, "its uid")
    Truthy(str.Contains(legacy.frame, `"session":"abc"`), "and rebuilt as a session frame")

    modern := ssid.Parse(`42["auth",{"sessionToken":"tok","uid":"7","lang":"fa"}]`, types.MODE_REAL, 0 as i64)
    Truthy(modern.ok, "the current dialect is read")
    Truthy(modern.has_init, "which also needs a user_init frame")
    Truthy(str.Contains(modern.frame, "cabinet/quick-high-low"), "the real cabinet url")

    Falsy(ssid.Parse("", types.MODE_DEMO, 0 as i64).ok, "empty is refused")
    Falsy(ssid.Parse("bare-session", types.MODE_DEMO, 0 as i64).ok, "a bare session needs a uid")
    Truthy(ssid.Parse("bare-session", types.MODE_DEMO, 9 as i64).ok, "and works with one")
end

func TestLimits():
    mut c := config.Config {}
    c.min_amount = 1.0
    c.max_amount = 100.0
    c.min_duration = 5 as i64
    c.max_duration = 3600 as i64

    EqStr(config.CheckLimits(c, 5.0, types.EXPIRY_FIXED, 60 as i64, 60 as i64, 1 as i64), "", "an ordinary order passes")
    Truthy(config.CheckLimits(c, 0.5, types.EXPIRY_FIXED, 60 as i64, 60 as i64, 1 as i64).len() > 0, "too small an amount")
    Truthy(config.CheckLimits(c, 500.0, types.EXPIRY_FIXED, 60 as i64, 60 as i64, 1 as i64).len() > 0, "too large an amount")
    Truthy(config.CheckLimits(c, 5.0, types.EXPIRY_FIXED, 2 as i64, 60 as i64, 1 as i64).len() > 0, "too short a trade")
    Truthy(config.CheckLimits(c, 5.0, types.EXPIRY_FLOATING, 60 as i64, 3600 as i64, 2 as i64).len() > 0, "too long a floating trade")
end

func TestStore():
    Truthy(store.Open(":memory:"), "an in-memory database opens")

    o := types.Order {}
    o.chat_id = 1 as i64
    o.symbol = "GBPAUD_otc"
    o.direction = types.CALL
    o.trigger_price = 1.9532
    o.amount = 3.0
    o.reference_price = 1.9
    o.has_reference = true
    o.approach_side = types.SIDE_BELOW
    o.min_payout = 88 as i64

    saved := store.Create(o)
    EqInt(saved.id.len(), 4, "the id is four characters")
    EqStr(saved.status, types.ST_PENDING, "a new order is pending")

    back := store.Get(saved.id)
    EqStr(back.symbol, "GBPAUD_otc", "the symbol survives the round trip")
    EqFloat(back.trigger_price, 1.9532, "and so does the price")
    Truthy(back.has_reference, "a reference price that was set reads as set")
    EqInt(back.min_payout, 88, "and so does the payout floor")

    mut active := store.ListActive()
    EqInt(active.len(), 1, "it is active")
    active.free()

    mut settled := back
    settled.status = types.ST_WON
    settled.profit = 2.7
    settled.has_profit = true
    settled.closed_at = timex.NowSeconds()
    settled.deal_id = "deal-1"
    store.Save(settled)

    EqStr(store.FindByDealId("deal-1").id, saved.id, "found by its deal id")
    EqInt(store.CountActiveByChat(1 as i64), 0, "and no longer active")

    mut won := 0 as i64
    mut lost := 0 as i64
    mut draw := 0 as i64
    mut profit := 0.0
    store.Summary(1 as i64, 0.0, won, lost, draw, profit)
    EqInt(won, 1, "one win")
    EqFloat(profit, 2.7, "and its profit")

    store.PutSetting("amount", "7")
    EqFloat(store.GetSettingFloat("amount", 1.0), 7.0, "a setting is stored")
    EqInt(store.GetSettingInt("missing", 42 as i64), 42, "and a missing one falls back")
    store.Close()
end

func TestCopy():
    o := types.Order {}
    o.id = "A7K2"
    o.symbol = "EURUSD"
    o.direction = types.PUT
    o.status = types.ST_OPEN

    card := texts.RenderOrder(o, 210 as i64, false)
    Has(card, "#A7K2", "the card names the order")
    Has(card, "EURUSD", "and its symbol")
    Has(card, "🔴 فروش", "and its direction")
    EqStr(texts.EscapeHtml("bad <input> & more"), "bad &lt;input&gt; &amp; more", "html is escaped")
    Has(texts.ChartGuide(), "هایکن‌آشی", "the chart guide explains heikin-ashi")
    Has(texts.TimeGuide(), "۳۰ دقیقه", "the time guide shows a Persian example")
end

func TestBigNumbers():
    // Telegram ids outgrew 32 bits years ago, and a supergroup id is around
    // -10^12. str.ToInt is 32 bits wide, so these must not go through it.
    EqInt(parse.ParseInt64("169298261"), 169298261, "an ordinary chat id")
    EqInt(parse.ParseInt64("5123456789"), 5123456789, "a modern user id, past 2^31")
    EqInt(parse.ParseInt64("-1001234567890"), 0 - 1001234567890, "a supergroup id")
    EqInt(parse.ParseInt64("1787971152596"), 1787971152596, "a millisecond timestamp")
    EqInt(parse.ParseInt64(" 42 "), 42, "spaces are trimmed")
    EqInt(parse.ParseInt64("۳۴۴۱۷۵۲۴"), 34417524, "Persian digits")
    EqInt(parse.ParseInt64(""), 0, "empty reads as zero")
    EqInt(parse.ParseInt64("abc"), 0, "so does nonsense")
    EqInt(parse.ParseInt64("12abc"), 12, "and a number stops at the first non-digit")
end

func TestSettings():
    Truthy(store.Open(":memory:"), "a database for the settings")
    mut c := config.Config {}
    c.default_amount = 2.0
    c.default_timeframe = 60 as i64
    c.demo_ssid = "seeded-from-env"
    settings.Init(c)

    EqFloat(settings.Amount(), 2.0, "an unset default comes from the environment")
    settings.SetAmount(7.5)
    EqFloat(settings.Amount(), 7.5, "and a stored one wins")

    EqStr(settings.Mode(), types.MODE_DEMO, "demo unless told otherwise")
    settings.SetMode(types.MODE_REAL)
    EqStr(settings.Mode(), types.MODE_REAL, "the account switch persists")

    EqInt(settings.MinPayout(), 0, "no payout floor unless one is asked for")
    settings.SetMinPayout(90 as i64)
    EqInt(settings.MinPayout(), 90, "and a stored one is remembered")

    Truthy(settings.NotifyBalance(), "balance notices are on by default")
    settings.SetNotifyBalance("off")
    Falsy(settings.NotifyBalance(), "and can be turned off")

    Falsy(settings.IsOwner(42 as i64), "a stranger is not an owner")
    settings.AddOwner(42 as i64)
    Truthy(settings.IsOwner(42 as i64), "the first chat claims the bot")
    settings.AddOwner(42 as i64)
    EqStr(settings.Owners(), "42", "claiming twice does not duplicate")
    settings.AddOwner(43 as i64)
    Truthy(settings.IsOwner(43 as i64), "a second owner is added")
    Truthy(settings.IsOwner(42 as i64), "without losing the first")

    EqStr(settings.Ssid(types.MODE_DEMO), "seeded-from-env", "the env seeds a session")
    settings.SetCredentials(types.MODE_DEMO, "pasted-by-user", 99 as i64)
    EqStr(settings.Ssid(types.MODE_DEMO), "pasted-by-user", "and /session overrides it")
    EqInt(settings.Uid(types.MODE_DEMO), 99, "with its uid")
    Falsy(settings.HasCredentials(types.MODE_REAL), "the other account is still empty")
    store.Close()
end

func TestNotifications():
    mut o := types.Order {}
    o.id = "A7K2"
    o.symbol = "EURUSD_otc"
    o.direction = types.CALL
    o.trigger_price = 1.0854
    o.open_price = 1.0855
    o.close_price = 1.0860
    o.amount = 5.0

    mut armed := engine_events.Event {}
    armed.kind = engine_events.EV_ARMED
    armed.order = o
    armed.price = 1.0854
    Has(tgbot.EventText(armed), "کندل بعدی", "an armed order says when it will enter")
    Has(tgbot.EventText(armed), "A7K2", "and names itself")

    mut opened := engine_events.Event {}
    opened.kind = engine_events.EV_OPENED
    opened.order = o
    Has(tgbot.EventText(opened), "معامله باز شد", "an opened trade")

    mut won := engine_events.Event {}
    won.kind = engine_events.EV_SETTLED
    mut winner := o
    winner.status = types.ST_WON
    winner.profit = 4.2
    winner.has_profit = true
    won.order = winner
    Has(tgbot.EventText(won), "برد", "a win")
    Has(tgbot.EventText(won), "$4.20", "with its profit")

    mut lost := engine_events.Event {}
    lost.kind = engine_events.EV_SETTLED
    mut loser := o
    loser.status = types.ST_LOST
    loser.profit = 0.0 - 5.0
    loser.has_profit = true
    lost.order = loser
    Has(tgbot.EventText(lost), "باخت", "a loss")
    Has(tgbot.EventText(lost), "-$5.00", "with its size")

    mut failed := engine_events.Event {}
    failed.kind = engine_events.EV_FAILED
    failed.order = o
    failed.detail = "bad <input> & more"
    Has(tgbot.EventText(failed), "bad &lt;input&gt; &amp; more", "a broker error is escaped, not injected")

    mut expired := engine_events.Event {}
    expired.kind = engine_events.EV_EXPIRED
    expired.order = o
    Has(tgbot.EventText(expired), "منقضی شد", "an expiry")

    mut missed := engine_events.Event {}
    missed.kind = engine_events.EV_MISSED
    missed.order = o
    missed.detail = "کندل ورود گذشت"
    Has(tgbot.EventText(missed), "فرصت از دست رفت", "a missed entry")

    mut skipped := engine_events.Event {}
    skipped.kind = engine_events.EV_SKIPPED
    mut floored := o
    floored.status = types.ST_SKIPPED
    floored.min_payout = 90 as i64
    skipped.order = floored
    skipped.price = 1.0854
    skipped.detail = "نرخ پرداخت این نماد در همان لحظه 65٪ بود و از حداقل 90٪ شما کمتر است."
    Has(tgbot.EventText(skipped), "معامله زده نشد", "a payout floor that stopped a trade")
    Has(tgbot.EventText(skipped), "65٪", "says what the payout was")
    Has(tgbot.EventText(skipped), "A7K2", "and which order it was")

    mut late := engine_events.Event {}
    late.kind = engine_events.EV_SETTLE_LATE
    late.order = o
    Has(tgbot.EventText(late), "هنوز نرسیده", "a settlement the broker is late with")

    mut unknown := engine_events.Event {}
    unknown.kind = "something-new"
    unknown.order = o
    EqStr(tgbot.EventText(unknown), "", "an event with no wording says nothing")
end

/*
 * A whole account's symbol list, cut into messages.
 *
 * The listing used to stop at thirty rows in one message, which for an
 * account with 115 open markets meant most of them were never shown. What
 * matters here is that nothing is lost in the cutting and that no piece is
 * bigger than Telegram will take.
 */
func TestSymbolPages():
    mut list := Vector {} as Vector<symbols.Asset>
    defer list.free()
    mut i := 0
    while i < 115:
        mut a := symbols.Asset {}
        a.symbol = "SYM" + str.FromInt(i as i64) + "_otc"
        a.name = "A market with a name of the length the broker really sends " + str.FromInt(i as i64)
        a.payout = (115 - i) as i64
        a.has_payout = true
        a.is_open = true
        list.push(a)
        i = i + 1
    end

    mut shown := 0
    mut pages := tgbot.AssetPages(list, shown)
    defer pages.free()

    Truthy(pages.len() > 1, "a full account does not fit in one message")
    EqInt(shown as i64, 115, "every symbol was placed on a page")

    mut k := 0
    while k < pages.len():
        Truthy(pages.get(k).len() < 4000, "no page is bigger than Telegram takes")
        Truthy(pages.get(k).len() > 0, "and none of them is empty")
        k = k + 1
    end

    // Every symbol on exactly one page, in the order it was handed over.
    mut joined := ""
    mut j := 0
    while j < pages.len():
        joined = joined + "\n" + pages.get(j)
        j = j + 1
    end
    mut missing := 0
    mut m := 0
    while m < list.len():
        if !str.Contains(joined, list.get(m).symbol): missing = missing + 1 end
        m = m + 1
    end
    EqInt(missing as i64, 0, "and no symbol was lost between the pages")
    Truthy(str.IndexOf(joined, "SYM0_otc") < str.IndexOf(joined, "SYM114_otc"),
        "the order the listing was given in survives the cutting")

    mut none := Vector {} as Vector<symbols.Asset>
    defer none.free()
    mut empty_shown := 0
    mut empty := tgbot.AssetPages(none, empty_shown)
    defer empty.free()
    EqInt(empty.len() as i64, 0, "an empty listing is no pages at all")
    EqInt(empty_shown as i64, 0, "and nothing shown")
end

func TestPolling():
    // A canned getUpdates result, run through the same path the loop uses.
    // The bot has no token here, so Dispatch renders and tries to send;
    // nothing leaves the process and what is checked is the bookkeeping.
    Truthy(store.Open(":memory:"), "a database for the poll test")
    mut c := config.Config {}
    c.admin_ids = "5123456789"
    settings.Init(c)
    tgbot.UseFakeBot()
    tgbot.Configure(c)

    EqInt(tgbot.Offset(), 0, "a fresh bot starts at offset zero")

    first := `[{"update_id":10,"message":{"message_id":1,"date":0,"chat":{"id":5123456789,"type":"private"},"text":"/id"}}]`
    EqInt(tgbot.Apply(first) as i64, 1, "one update is handled")
    EqInt(tgbot.Offset(), 11, "and the offset moves past it")

    batch := `[{"update_id":11,"message":{"message_id":2,"date":0,"chat":{"id":5123456789,"type":"private"},"text":"/stats"}},` +
        `{"update_id":12,"message":{"message_id":3,"date":0,"chat":{"id":5123456789,"type":"private"},"text":"hello"}}]`
    EqInt(tgbot.Apply(batch) as i64, 2, "a batch is handled in order")
    EqInt(tgbot.Offset(), 13, "the offset ends past the last of them")

    // Telegram has been known to answer out of order after a restart.
    stale := `[{"update_id":5,"message":{"message_id":4,"date":0,"chat":{"id":5123456789,"type":"private"},"text":"/id"}}]`
    _n := tgbot.Apply(stale)
    EqInt(tgbot.Offset(), 13, "an older update never drags the offset backwards")

    EqInt(tgbot.Apply("[]") as i64, 0, "an empty answer is not an error")
    EqInt(tgbot.Apply("") as i64, 0, "and neither is an empty body")
    EqInt(tgbot.Offset(), 13, "neither moves the offset")

    tap := `[{"update_id":20,"callback_query":{"id":"q1","data":"h:chart",` +
        `"message":{"message_id":9,"date":0,"chat":{"id":5123456789,"type":"private"},"text":"panel"}}}]`
    EqInt(tgbot.Apply(tap) as i64, 1, "a button tap is an update like any other")
    EqInt(tgbot.Offset(), 21, "and moves the offset too")
    store.Close()
end

func main:
    TestDurations()
    TestFormatting()
    TestSymbols()
    TestOrderCommand()
    TestTrigger()
    TestPayoutFloor()
    TestExpiry()
    TestJson()
    TestSsid()
    TestLimits()
    TestStore()
    TestCopy()
    TestBigNumbers()
    TestSettings()
    TestNotifications()
    TestSymbolPages()
    TestPolling()
    os.Exit(testing.Summary())
end
