// Time the way this bot talks about it: durations a human typed, and the
// candle grid the broker settles on.
package timex

import str
import time
import conv

const MINUTE := 60 as i64
const HOUR := 3600 as i64
const DAY := 86400 as i64
const WEEK := 604800 as i64
const MONTH := 2592000 as i64
const YEAR := 31536000 as i64

// ParseDuration answers this when the text is not a duration at all.
pub const INVALID := 0 - 1 as i64

// Zero-width non-joiner, which Persian keyboards sprinkle inside words.
const ZWNJ := "‌"

// The multiplier for one unit word, or 0 when the word is not a unit.
// Every spelling the bot accepts lives here: English short, English long,
// and Persian, in either digit set and either letter shape.
func UnitSeconds(word: str): i64:
    if word == "s" || word == "sec" || word == "secs" || word == "second" || word == "seconds": ret 1 end
    if word == "ث" || word == "ثانیه" || word == "ثانیهها" || word == "ثانیهای": ret 1 end

    if word == "m" || word == "min" || word == "mins" || word == "minute" || word == "minutes": ret MINUTE end
    if word == "د" || word == "دق" || word == "دقیقه" || word == "دقیقهها" || word == "دقیقهای" || word == "دقایق": ret MINUTE end

    if word == "h" || word == "hr" || word == "hrs" || word == "hour" || word == "hours": ret HOUR end
    if word == "س" || word == "ساعت" || word == "ساعتها" || word == "ساعته": ret HOUR end

    if word == "d" || word == "day" || word == "days": ret DAY end
    if word == "ر" || word == "روز" || word == "روزها" || word == "روزه": ret DAY end

    if word == "w" || word == "wk" || word == "wks" || word == "week" || word == "weeks": ret WEEK end
    if word == "هفته" || word == "هفتهها" || word == "هفتهای": ret WEEK end

    if word == "mo" || word == "mon" || word == "mons" || word == "month" || word == "months": ret MONTH end
    if word == "ماه" || word == "ماهها" || word == "ماهه": ret MONTH end

    if word == "y" || word == "yr" || word == "yrs" || word == "year" || word == "years": ret YEAR end
    if word == "سال" || word == "سالها" || word == "ساله": ret YEAR end

    ret 0
end

// Lower-cases, unifies digits and Persian letter shapes, and turns every
// spelling of "and" into a space, so the scanner sees one flat form.
func Normalize(raw: str): str:
    mut s := str.ToEnglishDigits(raw)
    s = str.Lower(s)
    s = str.Replace(s, ZWNJ, "")
    s = str.Replace(s, "‎", "")
    s = str.Replace(s, "‏", "")
    s = str.Replace(s, "ي", "ی")
    s = str.Replace(s, "ك", "ک")
    s = str.Replace(s, "٫", ".")
    s = str.Replace(s, "٬", "")
    s = str.Replace(s, ",", " ")
    s = str.Replace(s, "+", " ")
    s = str.Replace(s, "&", " ")
    s = str.Replace(s, "،", " ")
    s = str.Replace(s, "؛", " ")
    s = str.Replace(s, ";", " ")
    s = str.Replace(s, " و ", " ")
    s = str.Replace(s, " and ", " ")
    ret str.Trim(s)
end

func IsDigitByte(c: str): bool:
    ret c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9"
end

func Pad2(n: i64): str:
    if n < 10: ret "0" + str.FromInt(n) end
    ret str.FromInt(n)
end

/*
 * Reads a human duration and returns whole seconds, or INVALID.
 *
 * Accepts `90`, `1m`, `1M`, `30 دقیقه`, `1h 30m`, `2 ساعت و 15 دقیقه`,
 * `3 days`, `1 ماه`. A bare number counts as seconds. Anything that is not a
 * number followed by a known unit makes the whole text invalid, so a typo is
 * reported rather than silently read as part of it.
 */
pub func ParseDuration(raw: str): i64:
    text := Normalize(raw)
    if text.len() == 0: ret INVALID end

    mut total := 0.0
    mut matched := false
    mut i := 0
    n := text.len()

    while i < n:
        while i < n && text.substr(i, 1) == " ": i = i + 1 end
        if i >= n: break end

        start := i
        mut dots := 0
        while i < n:
            c := text.substr(i, 1)
            if IsDigitByte(c):
                i = i + 1
            else c == "." && dots == 0:
                dots = dots + 1
                i = i + 1
            else:
                break
            end
        end
        if i == start: ret INVALID end
        value := str.ToFloat(text.substr(start, i - start))

        while i < n && text.substr(i, 1) == " ": i = i + 1 end
        wstart := i
        while i < n:
            c := text.substr(i, 1)
            if c == " " || IsDigitByte(c): break end
            i = i + 1
        end

        mut multiplier := 1 as i64
        if i > wstart:
            word := text.substr(wstart, i - wstart)
            multiplier = UnitSeconds(word)
            if multiplier == 0: ret INVALID end
        end

        total = total + value * (multiplier as f64)
        matched = true
    end

    if !matched: ret INVALID end
    seconds := (total + 0.5) as i64
    if seconds <= 0: ret INVALID end
    ret seconds
end

// The compact form the buttons wear: 1h30m, 90s, 2d.
pub func FormatDuration(seconds: i64): str:
    if seconds < MINUTE: ret str.FromInt(seconds) + "s" end

    d := seconds / DAY
    h := (seconds % DAY) / HOUR
    m := (seconds % HOUR) / MINUTE
    s := seconds % MINUTE

    mut out := ""
    if d > 0: out = out + str.FromInt(d) + "d" end
    if h > 0: out = out + str.FromInt(h) + "h" end
    if m > 0: out = out + str.FromInt(m) + "m" end
    if s > 0: out = out + str.FromInt(s) + "s" end
    if out.len() == 0: ret "0s" end
    ret out
end

// The same duration spelled out in Persian, for the panels people read.
pub func FormatDurationFa(seconds: i64): str:
    if seconds <= 0: ret "0 ثانیه" end

    mut rest := seconds
    mut parts := 0
    mut out := ""

    d := rest / DAY
    if d > 0:
        out = out + str.FromInt(d) + " روز"
        rest = rest - d * DAY
        parts = parts + 1
    end
    h := rest / HOUR
    if h > 0:
        if parts > 0: out = out + " و " end
        out = out + str.FromInt(h) + " ساعت"
        rest = rest - h * HOUR
        parts = parts + 1
    end
    m := rest / MINUTE
    if m > 0:
        if parts > 0: out = out + " و " end
        out = out + str.FromInt(m) + " دقیقه"
        rest = rest - m * MINUTE
        parts = parts + 1
    end
    if rest > 0:
        if parts > 0: out = out + " و " end
        out = out + str.FromInt(rest) + " ثانیه"
    end
    ret out
end

// Timeframes the chart offers, as the buttons list them.
pub func TimeframeLabel(seconds: i64): str:
    ret FormatDuration(seconds)
end

// Epoch seconds, with the fractional part the tick stream works in.
pub func NowSeconds(): f64:
    ret (time.NowMillis() as f64) / 1000.0
end

// The start of the candle a moment falls in, on the broker's clock.
pub func CandleOpenTime(t: f64, timeframe_seconds: i64): f64:
    tf := timeframe_seconds as f64
    ret ((t / tf) as i64 as f64) * tf
end

pub func CandleCloseTime(t: f64, timeframe_seconds: i64): f64:
    ret CandleOpenTime(t, timeframe_seconds) + (timeframe_seconds as f64)
end

// The close of the count-th candle from here, counting the current one as
// the first.
pub func NthCandleCloseTime(t: f64, timeframe_seconds: i64, count: i64): f64:
    mut n := count
    if n < 1: n = 1 as i64 end
    ret CandleOpenTime(t, timeframe_seconds) + (timeframe_seconds as f64) * (n as f64)
end

// A wall clock the user recognises: YYYY-MM-DD HH:MM:SS at the configured
// offset. Iran has no daylight saving, so a fixed offset is exact.
pub func FormatTime(epoch: f64, offset_minutes: i64): str:
    total := (epoch as i64) + offset_minutes * MINUTE
    days := total / DAY
    mut rem := total % DAY
    if rem < 0:
        rem = rem + DAY
    end

    hour := rem / HOUR
    minute := (rem % HOUR) / MINUTE
    second := rem % MINUTE

    // days since 1970-01-01 to a civil date (Howard Hinnant's algorithm)
    z := days + 719468 as i64
    era := z / 146097
    doe := z - era * 146097
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    y := yoe + era * 400
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp := (5 * doy + 2) / 153
    day := doy - (153 * mp + 2) / 5 + 1
    mut month := mp + 3
    mut year := y
    if mp >= 10:
        month = mp - 9
        year = y + 1
    end

    ret str.FromInt(year) + "-" + Pad2(month) + "-" + Pad2(day) + " " + Pad2(hour) + ":" + Pad2(minute) + ":" + Pad2(second)
end

// A price as the broker quotes it: five decimals, or three for big numbers,
// with the trailing zeros trimmed.
pub func FormatPrice(price: f64): str:
    mut decimals := 5
    mut abs := price
    if abs < 0.0: abs = 0.0 - abs end
    if abs >= 100.0: decimals = 3 end

    mut text := conv.FormatFloatPrec(price, decimals)
    while text.len() > 1 && text.substr(text.len() - 1, 1) == "0":
        text = text.substr(0, text.len() - 1)
    end
    if text.len() > 1 && text.substr(text.len() - 1, 1) == ".":
        text = text.substr(0, text.len() - 1)
    end
    ret text
end

// Money, always with two decimals and a sign in front of the dollar.
pub func FormatMoney(value: f64): str:
    mut abs := value
    mut sign := ""
    if value < 0.0:
        abs = 0.0 - value
        sign = "-"
    end
    ret sign + "$" + conv.FormatFloatPrec(abs, 2)
end
