// The vocabulary the whole bot speaks: one order, its states, and the
// account it belongs to.
package types

// Account: which broker cluster an order lives on. Demo and real are
// physically different servers, never one account with a flag.
pub const MODE_DEMO := "demo"
pub const MODE_REAL := "real"

pub const CALL := "call"
pub const PUT := "put"

// How the order enters once the price arrives.
pub const TRIGGER_TOUCH := "touch"
pub const TRIGGER_NEXT_CANDLE := "next_candle"

// How the trade ends: a fixed number of seconds, or the close of a candle.
pub const EXPIRY_FIXED := "fixed"
pub const EXPIRY_FLOATING := "floating"

// Chart the candles are drawn as. Only the shape changes; entry and close
// are always the real market price.
pub const CHART_CANDLE := "candle"
pub const CHART_HEIKIN_ASHI := "heikin_ashi"
pub const CHART_LINE := "line"

// Which side the market sat on when the order was created, so a trigger is
// a crossing and never mere proximity.
pub const SIDE_ABOVE := "above"
pub const SIDE_BELOW := "below"
pub const SIDE_ANY := "any"

// The order's life. Only pending and armed can still be called off: once
// it is being sent, the broker may already have taken it.
pub const ST_PENDING := "pending"
pub const ST_ARMED := "armed"
pub const ST_PLACING := "placing"
pub const ST_OPEN := "open"
pub const ST_WON := "won"
pub const ST_LOST := "lost"
pub const ST_DRAW := "draw"
pub const ST_CANCELLED := "cancelled"
pub const ST_FAILED := "failed"
pub const ST_EXPIRED := "expired"

// What the user asked for, before it becomes a stored order. The one-line
// command and the wizard panel both produce this shape.
@en "OrderSpec"
@fa "مشخصات سفارش"
pub struct OrderSpec:
    pub symbol: str = ""
    pub direction: str = CALL
    pub trigger_price: f64 = 0.0
    pub trigger_mode: str = TRIGGER_TOUCH
    pub timeframe_seconds: i64 = 60
    pub chart_type: str = CHART_CANDLE
    pub expiry_mode: str = EXPIRY_FIXED
    pub duration_seconds: i64 = 60
    pub candle_count: i64 = 1
    pub amount: f64 = 1.0
    pub account_mode: str = MODE_DEMO
    // 0 means the order waits for its price forever.
    pub valid_for_seconds: i64 = 0
end

// A stored order: the spec plus everything the engine learns about it.
@en "Order"
@fa "سفارش"
pub struct Order:
    pub id: str = ""
    pub chat_id: i64 = 0
    pub account_mode: str = MODE_DEMO

    pub symbol: str = ""
    pub direction: str = CALL

    pub trigger_price: f64 = 0.0
    pub trigger_mode: str = TRIGGER_TOUCH
    pub approach_side: str = SIDE_ANY

    pub amount: f64 = 1.0

    pub expiry_mode: str = EXPIRY_FIXED
    pub duration_seconds: i64 = 60
    pub candle_count: i64 = 1
    pub timeframe_seconds: i64 = 60
    pub chart_type: str = CHART_CANDLE

    pub status: str = ST_PENDING
    // The market price when the order was created, which decides which way
    // the price has to travel to count as a touch.
    pub reference_price: f64 = 0.0
    pub has_reference: bool = false
    // Epoch second after which an untriggered order is abandoned; 0 = never.
    pub valid_until: f64 = 0.0

    pub triggered_price: f64 = 0.0
    pub triggered_at: f64 = 0.0
    pub deal_id: str = ""
    pub open_price: f64 = 0.0
    pub opened_at: f64 = 0.0
    pub closes_at: f64 = 0.0

    pub close_price: f64 = 0.0
    pub closed_at: f64 = 0.0
    pub profit: f64 = 0.0
    pub has_profit: bool = false
    pub note: str = ""

    pub created_at: f64 = 0.0
    pub updated_at: f64 = 0.0
end

pub func IsActive(status: str): bool:
    ret status == ST_PENDING || status == ST_ARMED || status == ST_PLACING || status == ST_OPEN
end

// Only these two can still be cancelled; an open binary option cannot.
pub func IsCancellable(status: str): bool:
    ret status == ST_PENDING || status == ST_ARMED
end
